# Rabbit Ears — setup-alpine answerfile (unattended base install of the dev VM)
#
# Used by:  vm/install.py, which runs `setup-alpine -e -f /root/af` over the
#           VM's serial console (driven by vm/provision.sh / `uv run task vm-build`).
#
# setup-alpine *sources* this file as a shell script, so each line sets an
# option variable (verified against alpine-conf 3.22.0 / Alpine 3.24.2).
# See docs/alpine-install.md for the full flow.
#
# EVERY option setup-alpine consults must be set here. An unset option makes
# setup-alpine (or one of its setup-* children) ask an interactive question on
# the serial console. Nobody answers, so the install hangs forever before it
# writes the disk. tests/test_install.py enforces this. If you bump the Alpine
# release, re-check the list against the new alpine-conf's setup-alpine.
#
# Target: the KVM dev VM (4 vCPU / 2GB / 8GB IDE disk at /dev/sda).

# --- Identity ---
HOSTNAMEOPTS=rabbitears-vm

# --- Timezone (set to your zone) ---
TIMEZONEOPTS="US/Central"

# --- Keyboard: none (headless VM; skips the kbd package on the 8GB disk) ---
KEYMAPOPTS=none

# --- Device manager ---
DEVDOPTS=mdev

# --- Network: DHCP on eth0 (the VM's e1000 NIC) ---
INTERFACESOPTS="auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
"

# --- HTTP proxy: none. Unset, setup-proxy asks "HTTP/FTP proxy URL?". ---
PROXYOPTS=none

# --- Mirror: the local caching proxy (vm/apk-proxy.py; the host pulls from the
#     CDN and serves the VM fast). Started by the `vm-proxy` pre-hook of
#     `uv run task vm-build`; vm/provision.sh checks it answers before installing.
#     setup-apkrepos writes each word verbatim as one line of
#     /etc/apk/repositories, so these must be full *versioned* repo URLs: a bare
#     ".../alpine" makes apk fetch ".../alpine/x86_64/APKINDEX.tar.gz" (404).
#     The version must match ALPINE_VERSION in vm/provision.sh (a test checks).
#     community is needed by alpine/packages.txt (mpv, py3-evdev, exfatprogs). ---
APKREPOSOPTS="http://192.168.122.1:8081/alpine/v3.24/main http://192.168.122.1:8081/alpine/v3.24/community"

# --- NTP: chrony (the clock schedule depends on correct time) ---
NTPOPTS="chrony"

# --- Root: empty password (skips the interactive prompt; we use SSH key auth).
#     install.py also passes -e. ---
empty_root_password=1

# --- Extra user: none. Unset, setup-user asks "Setup a user?". ---
USEROPTS=none

# --- SSH: install sshd + authorize our key for root (passwordless for paramiko).
#     ROOTSSHKEY is a placeholder: vm/install.py replaces this line with the
#     clone's vm/keys/rabbitears-vm.pub (generated by provision.sh, gitignored)
#     when it sends the answerfile to the VM. The repo file is never rewritten. ---
SSHDOPTS=openssh
ROOTSSHKEY="injected-by-vm/install.py"

# --- Disk: the VM's 8GB system disk (IDE -> /dev/sda), installed as a sys disk ---
DISKOPTS="-m sys /dev/sda"
# Auto-confirm the "erase this disk" prompt (setup-disk checks ERASE_DISKS, and
# it must equal the disk list in DISKOPTS exactly). Must be exported so
# setup-disk (a child of setup-alpine) inherits it.
export ERASE_DISKS="/dev/sda"

# --- No lbu / apk-cache on the VM (those are box/M1 concerns) ---
LBUOPTS=none
APKCACHEOPTS=none
