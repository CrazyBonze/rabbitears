#!/sbin/openrc-run
# SPDX-License-Identifier: BSD-2-Clause
#
# Rabbit Ears — OpenRC init script.
#
# Runs the app under supervise-daemon, which respawns it on exit (SCOPE §4.7:
# "mpv crash: the service supervisor restarts it, and the app re-tunes").
#
# `supervisor=supervise-daemon` hands start/stop/status to OpenRC's framework
# (supervise_start/stop/status in /usr/libexec/rc/sh/supervise-daemon.sh),
# which invokes:  supervise-daemon <name> --start [opts] $command -- $command_args
# So we only declare `command` + `command_args`, plus a start_pre() to prepare
# the runtime dir. Do NOT define manual start()/stop() here — that is the
# start-stop-daemon pattern and conflicts with the supervisor.
#
# Installed to /etc/init.d/rabbitears by alpine/setup.sh.

name="rabbitears"
description="Rabbit Ears kid-safe cable box (mpv + clock schedule + remote)"

supervisor=supervise-daemon

# Logging: /var/log is RAM-backed on the diskless box and discarded at reboot.
# This is an explicit, intended exception to SCOPE §3's "never writes to /" rule
# (logs only, non-persistent).
output_log="/var/log/rabbitears.log"
error_log="/var/log/rabbitears.log"

# Export PYTHONPATH so the supervised process can import the app package
# installed at /opt/rabbitears. PYTHONDONTWRITEBYTECODE prevents Python from
# writing __pycache__ into /opt/rabbitears (which would break verify.sh's
# unmanaged-file check and violate "the app never writes to /").
supervise_daemon_args="--env PYTHONPATH=/opt --env PYTHONDONTWRITEBYTECODE=1"

# Respawn forever (SCOPE Goal 2: zero-interaction recovery). The default
# respawn_max gives up after repeated crashes, which would leave the box stuck.
respawn_max=0
respawn_delay=2

# The command to supervise (respawned on exit). The app is installed at
# /opt/rabbitears; PYTHONPATH=/opt (from supervise_daemon_args) makes it
# importable. A crash exits non-zero, so supervise-daemon respawns it and the
# new instance re-tunes (SCOPE §4.7).
command="/usr/bin/python3"
command_args="-m rabbitears"

# /run is a tmpfs (cleared at boot); the mpv JSON IPC socket lives at
# /run/rabbitears/mpv.sock, so create the directory before the daemon starts.
# Also run the mdev coldplug loop: the stick may already be enumerated before
# the mdev rule fires at boot, so mount an already-attached RABBITEARS drive
# here. One mount implementation, shared with hotplug (SCOPE §4.8).
start_pre() {
	install -d -m 0755 /run/rabbitears
	for _dev in /dev/sd*; do
		[ -e "$_dev" ] || continue
		MDEV="$(basename "$_dev")" ACTION=add /etc/rabbitears/mdev-usb
	done
}

depend() {
	need localmount
	after bootmisc
	# 'use' (not 'need') so a failed network does not block the service
	# (SCOPE Goal #2: zero-interaction recovery). The app plays local media
	# and does not strictly require the network.
	use net
}
